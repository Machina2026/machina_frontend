# Copy to .env.local for local settings. Never commit real secrets.

# Machina API (machina_backend). When set, sign-in, registration, account, team
# and admin requests go to it (proxied under /api, see next.config.ts), and the
# built-in mock API serves the rest with the API's signed-in user.
# Leave it unset to run everything on the built-in mock API.
MACHINA_API_URL=http://localhost:4000
